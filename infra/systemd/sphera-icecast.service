[Unit]
Description=Sphera Icecast2 Streaming Server
After=network.target

[Service]
Type=simple
ExecStart=/mnt/d/KIro_projectsbot/sphera-main/infra/systemd/sphera-icecast.sh
Restart=always
RestartSec=3
StandardOutput=append:/mnt/d/KIro_projectsbot/sphera-main/.logs/icecast.log
StandardError=append:/mnt/d/KIro_projectsbot/sphera-main/.logs/icecast.log

[Install]
WantedBy=default.target
