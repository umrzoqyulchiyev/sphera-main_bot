# ============================================================
#  INTRA GROUP — Environment Variables
#  Ko'chirish: cp .env.example .env
#  MUHIM: .env fayliga # bilan izoh YOZMANG! Pydantic uni qiymatga qo'shadi.
# ============================================================

# ── App ──────────────────────────────────────────────────────
DEBUG=false

# ── Telegram Bot ─────────────────────────────────────────────
BOT_TOKEN=your_botfather_token_here
BOT_USERNAME=
ADMIN_IDS=123456789
COMMUNITY_CHAT_ID=
DISABLE_GROUP_CHECK=true

# ── Mini App / API ────────────────────────────────────────────
MINI_APP_URL=https://YOUR-RAILWAY-URL.up.railway.app
API_URL=https://YOUR-RAILWAY-URL.up.railway.app
INTERNAL_API_URL=https://YOUR-RAILWAY-URL.up.railway.app
MINIAPP_DIR=static

# ── Database ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=radio_db
DB_POOL_MIN=2
DB_POOL_MAX=20

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=change_this_to_at_least_32_random_characters_here
INTERNAL_API_KEY=change_this_internal_key_too
ALLOWED_ORIGINS=*

# ── AI (Google Gemini) ────────────────────────────────────────
GEMINI_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── STT (faster-whisper) ─────────────────────────────────────
WHISPER_MODEL=small

# ── TTS ───────────────────────────────────────────────────────
TTS_PROVIDER=edge
TTS_FALLBACK_EDGE=true
ELEVENLABS_API_KEY=
ELEVEN_MODEL=eleven_multilingual_v2
ELEVEN_VOICE_RU=
ELEVEN_VOICE_LT=
ELEVEN_VOICE_EN=

# ── Icecast (jonli efir — Railway'da USE_ICECAST=true ishlatiladi) ──
USE_ICECAST=true
ICECAST_HOST=localhost
ICECAST_PORT=8000
ICECAST_PASS=change_this_icecast_password_here

# ── MediaMTX (lokal dev uchun alternativ) ────────────────────
USE_MEDIAMTX=false
MEDIAMTX_HOST=localhost
MEDIAMTX_RTMP_PORT=1935
MEDIAMTX_HLS_PORT=8888
MEDIAMTX_PUBLISH_PASS=change_this_mediamtx_password

# ── Storage ───────────────────────────────────────────────────
AUDIO_DIR=/tmp/sphera_audio
UPLOAD_DIR=/tmp/sphera_uploads
MAX_UPLOAD_MB=20

# ── Points cost-model ─────────────────────────────────────────
COST_CHAT=1
COST_CHAT_VOICE=1
COST_STUDIO=1
COST_STUDIO_VOICE=2
INITIAL_POINTS=50

# ── Aggregator ────────────────────────────────────────────────
AGGREGATOR_MIN_MESSAGES=5
AGGREGATOR_INTERVAL=120

# ── TO'LOV TIZIMI ────────────────────────────────────────────

# Variant 1: Telegram Stars (XTR) — TAVSIYA ETILGAN, hech qanday hujjat kerak emas
PAYMENT_CURRENCY=XTR
PAYMENT_PROVIDER_TOKEN=

# Variant 2: CryptoBot (TON/USDT/BTC) — global, komissiya ~1%
# Setup: @CryptoBot → Manage Apps → Create App → API token olish
# Webhook: CryptoBot App settings → Webhook URL → https://YOUR-RAILWAY-URL/users/cryptobot-webhook
CRYPTOBOT_API_TOKEN=

# Variant 3: Stripe (karta to'lovi, faqat ba'zi davlatlar)
# Setup: BotFather → /mybots → bot → Payments → Stripe Test/Live
# PAYMENT_PROVIDER_TOKEN=stripe_live_token_here

# ── Telegram MTProto (Voice Chat uchun — ixtiyoriy) ──────────
TG_API_ID=0
TG_API_HASH=
TG_SESSION_STRING=
VOICE_CHAT_GROUP_ID=
